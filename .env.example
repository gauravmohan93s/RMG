# ============================================================
# RMG Forecasting Pipeline - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file with real credentials!
# ============================================================

# DATABASE CREDENTIALS
# ──────────────────────────────────────────────────────────
DB_SERVER=sql-web-edition.cqu5cuepe15y.ap-south-1.rds.amazonaws.com
DB_NAME=Kc_WebAppDb_New_Migrated
DB_USERNAME=your_username_here
DB_PASSWORD=your_password_here
DB_DRIVER=ODBC Driver 17 for SQL Server

# DATA PATHS
# ──────────────────────────────────────────────────────────
# Base data directory
RMG_DATA_ROOT=C:\Users\gsakhare\OneDrive - KC OVERSEAS EDUCATION PVT LTD\RMG\RMG Calculations

# Output directory for pipeline run artifacts (per-date folders are created automatically)
RMG_OUT_DIR=C:\Users\gsakhare\OneDrive - KC OVERSEAS EDUCATION PVT LTD\RMG\RMG Calculations\Predictions

# DATA FETCH PARAMETERS
# ──────────────────────────────────────────────────────────
# Start date for historical data (YYYY-MM-DD format)
FETCH_START_DATE=2020-01-01

# End date (leave empty to use yesterday in IST timezone)
FETCH_END_DATE=

# Default submitted stages for applications
FETCH_DEFAULT_SUBMITTED_STAGES=4,81

# TRANSFORMATION SETTINGS
# ──────────────────────────────────────────────────────────
# Enable auto-mapping of unmapped CountryIDs/TagGroupIDs to "Other"
# If False, pipeline will pause and ask for manual intervention
TRANSFORM_AUTO_MAP=true

# Log unmapped items to file for review (path relative to RMG_OUT_DIR)
TRANSFORM_LOG_UNMAPPED=unmapped_items.log

# FORECASTING PARAMETERS
# ──────────────────────────────────────────────────────────
# Number of months to forecast into the future
FORECAST_HORIZON=12

# Random seed for reproducibility
RANDOM_SEED=42

# LLM SETTINGS (Optional - for report generation with Ollama)
# ──────────────────────────────────────────────────────────
# Ollama server URL
OLLAMA_HOST=http://localhost:11434

# Comma-separated list of models to try (in order of preference)
OLLAMA_MODEL_ORDER=phi3:mini,qwen2:0.5b

# Context size (number of tokens)
OLLAMA_NUM_CTX=512

# Timeout for LLM requests (seconds)
OLLAMA_TIMEOUT=60

# LOGGING
# ──────────────────────────────────────────────────────────
# Log file path
LOG_FILE=pipeline.log

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# DEVELOPMENT / DEBUGGING
# ──────────────────────────────────────────────────────────
# Set to True for verbose output
DEBUG=False

# Run only specific models (comma-separated, e.g., "model01_lastyear,model05_prophet")
# Leave empty to run all
MODELS_ONLY=

# Skip specific models (comma-separated)
MODELS_EXCLUDE=
